classDiagram
    class Owner {
        +name: str
        +daily_available_minutes: int
        +preferred_start_hour: int
        +preferred_end_hour: int
        +preferences: List[str]
        +pets: List[Pet]
        +add_pet(pet: Pet) void
        +get_all_tasks() List[Task]
    }

    class Pet {
        +name: str
        +species: str
        +owner: Owner
        +age_years: Optional[int]
        +notes: str
        +tasks: List[Task]
        +add_task(task: Task) void
    }

    class Task {
        +title: str
        +duration_minutes: int
        +priority: str
        +category: str
        +preferred_start_hour: Optional[int]
        +recurring: bool
        +notes: str
        +completed: bool
        +frequency: str
        +due_date: Optional[date]
        +pet_name: Optional[str]
        +priority_score() int
        +mark_complete() Optional[Task]
    }

    class ScheduledTask {
        +task: Task
        +start_minute: int
        +end_minute: int
        +reason: str
    }

    class DailyPlan {
        +scheduled_tasks: List[ScheduledTask]
        +unscheduled_tasks: List[Task]
        +owner: Owner
        +pet: Pet
        +day_start_hour: int
        +day_end_hour: int
        +total_scheduled_minutes: int
    }

    class Scheduler {
        +day_start_hour: int
        +day_end_hour: int
        +sort_by_time(tasks: List[Task]) List[Task]
        +filter_tasks(tasks: List[Task], pet_name: Optional[str], completed: Optional[bool]) List[Task]
        +detect_conflicts(scheduled_tasks: List[ScheduledTask]) List[str]
        +build_daily_plan(owner: Owner, pet: Pet, tasks: List[Task]) DailyPlan
        +explain_plan(plan: DailyPlan) List[str]
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : contains
    Task --> ScheduledTask : becomes
    DailyPlan --> ScheduledTask : contains
    DailyPlan --> Task : tracks unscheduled
    Scheduler --> DailyPlan : creates
